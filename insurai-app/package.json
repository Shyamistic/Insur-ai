{
  "name": "insurai-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pbt": "vitest run src/tests/pbt.test.ts",
    "sensor:consumer": "tsx services/sensor-consumer.ts",
    "eliza:agent": "tsx agents/insurance-eliza/src/index.ts",
    "deploy:testnet": "npx hardhat run scripts/deploy.ts --network 0g-galileo",
    "deploy:mainnet": "npx hardhat run scripts/deploy.ts --network 0g-mainnet",
    "compile": "npx hardhat compile",
    "activity:testnet": "npx tsx scripts/generate-activity.ts --network=0g-galileo --count=10",
    "activity:mainnet": "npx tsx scripts/generate-activity.ts --network=0g-mainnet --count=5",
    "health": "curl -s http://localhost:3000/api/health | npx json"
  },
  "dependencies": {
    "@0gfoundation/0g-storage-ts-sdk": "^1.2.9",
    "@0gfoundation/0g-ts-sdk": "^1.2.8",
